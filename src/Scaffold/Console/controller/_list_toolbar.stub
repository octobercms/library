<div data-control="toolbar loader-container">
{% if design == 'popup' %}
    <?= Ui::popupButton(
        label: __("New :name", ['name' => '{{title_singular_name}}']),
        handler: 'onLoadPopupForm',
        icon: 'ph ph-plus',
        primary: true
    ) ?>
{% else %}
    <?= Ui::button(
        label: __("New :name", ['name' => '{{title_singular_name}}']),
        href: Backend::url('{{namespace_path}}/{{lower_name}}/create'),
        icon: 'ph ph-plus',
        primary: true
    ) ?>
{% endif %}

    <div class="toolbar-divider"></div>

    <?= Ui::ajaxButton(
        label: __("Delete"),
        handler: 'onDelete',
        icon: 'ph ph-trash',
        secondary: true,
        disabled: true,
        dataRequestMessage: __("Deleting..."),
        dataRequestConfirm: __("Are you sure?"),
        dataListCheckedTrigger: true,
        dataListCheckedRequest: true
    ) ?>
</div>
