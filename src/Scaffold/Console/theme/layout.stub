##
description = "Default layout"
==
{% verbatim %}<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{{ this.page.title }}</title>
        {% styles %}
    </head>
    <body>
        {% page %}

        {% framework extras %}
        {% scripts %}
    </body>
</html>{% endverbatim %}