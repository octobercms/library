<div class="filter-box">
    <div class="filter-facet">
        <div class="facet-item is-grow">
            <select name="Filter[value]" class="form-control form-control-sm custom-select">
                <option value="1" <?= $scope->value === '1' ? 'selected="selected"' : '' ?>><?= __("has a discount") ?></option>
                <option value="0" <?= $scope->value === '0' ? 'selected="selected"' : '' ?>><?= __("does not have a discount") ?></option>
            </select>
        </div>
    </div>
    <div class="filter-buttons">
        <?= Ui::button(
            label: __("Apply"),
            primary: true,
            class: 'btn-sm',
            dataFilterAction: 'apply'
        ) ?>
        <div class="flex-grow-1"></div>
        <?= Ui::button(
            label: __("Clear"),
            secondary: true,
            class: 'btn-sm',
            dataFilterAction: 'clear'
        ) ?>
    </div>
</div>
